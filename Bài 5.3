        private void LoadData()
        {
            products.Add(new Product("SP01", "iPhone 15", 20000000, 5, "Điện thoại"));
            products.Add(new Product("SP02", "Dell Inspiron", 18000000, 3, "Laptop"));
            products.Add(new Product("SP03", "Chuột Logitech", 500000, 10, "Phụ kiện"));

            bindingSource.DataSource = products;
            dgvProducts.DataSource = bindingSource;
        }

        private void btnAdd_Click(object sender, EventArgs e)
        {
            decimal price;
            int quantity;

            if (!decimal.TryParse(txtUnitPrice.Text, out price) ||
                !int.TryParse(txtQuantity.Text, out quantity))
            {
                MessageBox.Show("Đơn giá hoặc số lượng không hợp lệ!");
                return;
            }

            Product product = new Product(
                txtProductId.Text,
                txtProductName.Text,
                price,
                quantity,
                cboCategory.Text
            );

            products.Add(product);
            RefreshGrid();
            ClearInput();
        }

        private void btnEdit_Click(object sender, EventArgs e)
        {
            if (dgvProducts.CurrentRow == null)
                return;

            Product product = dgvProducts.CurrentRow.DataBoundItem as Product;

            if (product == null)
                return;

            decimal price;
            int quantity;

            if (!decimal.TryParse(txtUnitPrice.Text, out price) ||
                !int.TryParse(txtQuantity.Text, out quantity))
            {
                MessageBox.Show("Dữ liệu không hợp lệ!");
                return;
            }

            product.ProductId = txtProductId.Text;
            product.ProductName = txtProductName.Text;
            product.UnitPrice = price;
            product.Quantity = quantity;
            product.Category = cboCategory.Text;

            RefreshGrid();
            ClearInput();
        }

        private void btnDelete_Click(object sender, EventArgs e)
        {
            if (dgvProducts.CurrentRow == null)
                return;

            Product product = dgvProducts.CurrentRow.DataBoundItem as Product;

            if (product == null)
                return;

            DialogResult result = MessageBox.Show(
                "Bạn có chắc muốn xóa sản phẩm này?",
                "Xác nhận",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Question
            );

            if (result == DialogResult.Yes)
            {
                products.Remove(product);
                RefreshGrid();
                ClearInput();
            }
        }

        private void btnSearch_Click(object sender, EventArgs e)
        {
            string keyword = txtSearch.Text.Trim().ToLower();

            var result = products
                .Where(p => p.ProductName.ToLower().Contains(keyword))
                .ToList();

            bindingSource.DataSource = result;
            dgvProducts.DataSource = bindingSource;
        }

        private void dgvProducts_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0)
                return;

            Product product = dgvProducts.Rows[e.RowIndex].DataBoundItem as Product;

            if (product == null)
                return;

            txtProductId.Text = product.ProductId;
            txtProductName.Text = product.ProductName;
            txtUnitPrice.Text = product.UnitPrice.ToString();
            txtQuantity.Text = product.Quantity.ToString();
            cboCategory.Text = product.Category;
        }

        private void RefreshGrid()
        {
            bindingSource.DataSource = null;
            bindingSource.DataSource = products;
            dgvProducts.DataSource = bindingSource;
        }

        private void ClearInput()
        {
            txtProductId.Clear();
            txtProductName.Clear();
            txtUnitPrice.Clear();
            txtQuantity.Clear();
            cboCategory.SelectedIndex = 0;
        }
    }

    public class Product
    {
        public string ProductId { get; set; }
        public string ProductName { get; set; }
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; }
        public string Category { get; set; }

        public Product(
            string productId,
            string productName,
            decimal unitPrice,
            int quantity,
            string category)
        {
            ProductId = productId;
            ProductName = productName;
            UnitPrice = unitPrice;
            Quantity = quantity;
            Category = category;
        }
    }
}
