        Button btnAdd;
        Button btnEdit;
        Button btnDelete;
        Button btnSearch;

        DataGridView dgvProducts;

        List<Product> products = new List<Product>();
        BindingSource bindingSource = new BindingSource();

        public Form1()
        {
            InitializeComponent();
            TaoGiaoDien();
