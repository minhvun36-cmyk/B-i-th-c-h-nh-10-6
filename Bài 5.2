        Button btnRemove;
        Button btnClearAll;

        Label lblTotal;
        Label lblDiscount;
        Label lblPayment;

        List<Service> services = new List<Service>();

        public Form1()
        {
            InitializeComponent();
            TaoGiaoDien();
            TaoDuLieu();
