        private void TaoDuLieu()
        {
            services.Add(new Service("Khám bệnh", "Khám tổng quát", 200000));
            services.Add(new Service("Khám bệnh", "Khám chuyên khoa", 300000));
            services.Add(new Service("Xét nghiệm", "Xét nghiệm máu", 150000));
            services.Add(new Service("Xét nghiệm", "Xét nghiệm nước tiểu", 100000));
            services.Add(new Service("Chụp X-Quang", "X-Quang phổi", 250000));
            services.Add(new Service("Chụp X-Quang", "X-Quang xương", 300000));
            services.Add(new Service("Vắc-xin", "Vắc-xin cúm", 350000));
            services.Add(new Service("Vắc-xin", "Vắc-xin viêm gan B", 400000));
        }

        private void LoadCategory()
        {
            cboCategory.Items.Add("Khám bệnh");
            cboCategory.Items.Add("Xét nghiệm");
            cboCategory.Items.Add("Chụp X-Quang");
            cboCategory.Items.Add("Vắc-xin");

            cboCategory.SelectedIndex = 0;
        }

        private void cboCategory_SelectedIndexChanged(object sender, EventArgs e)
        {
            lstAvailableServices.Items.Clear();

            string category = cboCategory.SelectedItem.ToString();

            foreach (Service service in services)
            {
                if (service.Category == category)
                {
                    lstAvailableServices.Items.Add(service);
                }
            }
        }

        private void btnSelect_Click(object sender, EventArgs e)
        {
            if (lstAvailableServices.SelectedItem == null)
                return;

            Service service = (Service)lstAvailableServices.SelectedItem;

            if (!lstSelectedServices.Items.Contains(service))
            {
                lstSelectedServices.Items.Add(service);
            }

            TinhTien();
        }

        private void lstAvailableServices_DoubleClick(object sender, EventArgs e)
        {
            btnSelect_Click(sender, e);
        }

        private void btnRemove_Click(object sender, EventArgs e)
        {
            if (lstSelectedServices.SelectedItem != null)
            {
                lstSelectedServices.Items.Remove(
                    lstSelectedServices.SelectedItem
                );
            }

            TinhTien();
        }

        private void btnClearAll_Click(object sender, EventArgs e)
        {
            lstSelectedServices.Items.Clear();
            TinhTien();
        }

        private void cboDiscount_SelectedIndexChanged(object sender, EventArgs e)
        {
            TinhTien();
        }

        private void TinhTien()
        {
            decimal total = 0;

            foreach (Service service in lstSelectedServices.Items)
            {
                total += service.Price;
            }

            decimal discountPercent = 0;

            if (cboDiscount.SelectedIndex == 1)
                discountPercent = 10;

            if (cboDiscount.SelectedIndex == 2)
                discountPercent = 20;

            decimal payment = total - total * discountPercent / 100;

            lblTotal.Text = "Tổng tiền: " + total.ToString("N0") + " VNĐ";
            lblDiscount.Text = "Chiết khấu: " + discountPercent + "%";
            lblPayment.Text = "Thành tiền: " + payment.ToString("N0") + " VNĐ";
        }
    }

    public class Service
    {
        public string Category { get; set; }
        public string Name { get; set; }
        public decimal Price { get; set; }

        public Service(string category, string name, decimal price)
        {
            Category = category;
            Name = name;
            Price = price;
        }

        public override string ToString()
        {
            return Name + " - " + Price.ToString("N0") + " VNĐ";
        }
    }
}
