        private void TaoCay()
        {
            tvDepartments.Nodes.Clear();

            TreeNode root = new TreeNode("Công ty");
            root.Tag = "Công ty";

            TreeNode kinhDoanh = new TreeNode("Phòng Kinh doanh");
            kinhDoanh.Tag = "Kinh doanh";

            kinhDoanh.Nodes.Add(new TreeNode("Nhóm 1"));
            kinhDoanh.Nodes.Add(new TreeNode("Nhóm 2"));

            TreeNode kyThuat = new TreeNode("Phòng Kỹ thuật");
            kyThuat.Tag = "Kỹ thuật";

            kyThuat.Nodes.Add(new TreeNode("Nhóm 1"));
            kyThuat.Nodes.Add(new TreeNode("Nhóm 2"));

            TreeNode taiChinh = new TreeNode("Phòng Tài chính");
            taiChinh.Tag = "Tài chính";

            taiChinh.Nodes.Add(new TreeNode("Nhóm 1"));

            root.Nodes.Add(kinhDoanh);
            root.Nodes.Add(kyThuat);
            root.Nodes.Add(taiChinh);

            tvDepartments.Nodes.Add(root);
            root.Expand();
        }

        private void tvDepartments_AfterSelect(
            object sender,
            TreeViewEventArgs e)
        {
            if (e.Node.Parent == null)
            {
                LoadEmployees("Công ty");
                return;
            }

            if (e.Node.Parent.Parent == null)
            {
                LoadEmployees(e.Node.Tag.ToString());
                return;
            }

            string department = e.Node.Parent.Tag.ToString();
            string group = e.Node.Text;

            LoadEmployees(department, group);
        }

        private void LoadEmployees(string department)
        {
            lsvEmployees.Items.Clear();

            foreach (Employee emp in employees)
            {
                if (emp.Department == department)
                {
                    AddEmployee(emp);
                }
            }
        }

        private void LoadEmployees(string department, string group)
        {
            lsvEmployees.Items.Clear();

            foreach (Employee emp in employees)
            {
                if (emp.Department == department &&
                    emp.Group == group)
                {
                    AddEmployee(emp);
                }
            }
        }

        private void AddEmployee(Employee emp)
        {
            ListViewItem item = new ListViewItem(
                emp.Id,
                0
            );

            item.SubItems.Add(emp.Name);
            item.SubItems.Add(emp.Position);
            item.SubItems.Add(emp.StartDate);

            lsvEmployees.Items.Add(item);
        }

        private void cboView_SelectedIndexChanged(
            object sender,
            EventArgs e)
        {
            if (cboView.SelectedIndex == 0)
                lsvEmployees.View = View.Details;

            if (cboView.SelectedIndex == 1)
                lsvEmployees.View = View.LargeIcon;

            if (cboView.SelectedIndex == 2)
                lsvEmployees.View = View.SmallIcon;

            if (cboView.SelectedIndex == 3)
                lsvEmployees.View = View.Tile;
        }
    }

    public class Employee
    {
        public string Id { get; set; }
        public string Name { get; set; }
        public string Position { get; set; }
        public string StartDate { get; set; }
        public string Department { get; set; }
        public string Group { get; set; }

        public Employee(
            string id,
            string name,
            string position,
            string startDate,
            string department,
            string group)
        {
            Id = id;
            Name = name;
            Position = position;
            StartDate = startDate;
            Department = department;
            Group = group;
        }
    }
